# ======================================
# Application
# ======================================
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
LOG_LEVEL=info

# ======================================
# Supabase
# ======================================
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ======================================
# Redis
# ======================================
# Use REDIS_URL when possible, otherwise fallback to REDIS_HOST and REDIS_PORT.
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ======================================
# Notification service
# ======================================
NOTIFICATION_SERVICE_URL=https://universearch-notification-service.onrender.com
NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=4000
NOTIFICATION_SERVICE_TIMEOUT_MS=60000

# ======================================
# Queue and admin
# ======================================
VIDEO_QUEUE_ADMIN_TOKEN=your_admin_token_here
VIDEO_QUEUE_METRICS_WINDOW_MS=300000
VIDEO_QUEUE_RETRY_ALL_LIMIT=50
INTERNAL_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
INTERNAL_ADMIN_RATE_LIMIT_MAX=20
FFMPEG_TIMEOUT_MS=60000

# ======================================
# Upload quotas
# ======================================
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX=5
UPLOAD_DAILY_RATE_LIMIT_WINDOW_SECONDS=86400
UPLOAD_DAILY_RATE_LIMIT_MAX=200